# ---------- Node 依赖（联机服务器用，运行时 npm install 即可重建） ----------
node_modules/

# ---------- 调试产物（本地验证用，运行时和站点都不需要） ----------
tools/out/
tools/_*/
tools/_*
tools/*.log
tools/*.txt

# ---------- 原始素材（11MB，只用于离线加工，网站跑起来不需要） ----------
素材/
素材.png
菜单.png

# ---------- 音乐素材（程序化合成音效，仓库只放可运行站点，故意不入库） ----------
assets/music/

# ---------- 零散封面/素材图（根目录与 tools/ 下的非站点资源） ----------
*封面.png
素材.png
菜单.png

# ---------- 沙箱推送的临时状态 ----------
.git-sandbox-push/

